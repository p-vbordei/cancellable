{
  "name": "@p-vbordei/cancellable",
  "version": "0.1.0",
  "description": "Promise utilities for AbortSignal: cancellable() wrapper, withTimeout, abortable sleep, deferred, anySignal combinator. Zero dependencies.",
  "keywords": [
    "abort",
    "abortsignal",
    "cancel",
    "timeout",
    "deferred",
    "sleep"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "Vlad Bordei",
    "email": "bordeivlad@gmail.com",
    "url": "https://github.com/p-vbordei"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/p-vbordei/cancellable.git"
  },
  "bugs": {
    "url": "https://github.com/p-vbordei/cancellable/issues"
  },
  "homepage": "https://github.com/p-vbordei/cancellable#readme",
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
